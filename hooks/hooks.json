{
  "description": "jev-kit 선택지 점검 hook (kit/options). ~/.config/jev/env의 JEV_OPTIONS가 off(기본)면 아무것도 하지 않는다.",
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/kit/options/jev_options.py\"", "timeout": 10}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/kit/options/jev_options.py\"", "timeout": 10}]}
    ],
    "PreToolUse": [
      {"matcher": "AskUserQuestion", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/kit/options/jev_options.py\"", "timeout": 10}]}
    ]
  }
}
